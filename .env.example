# LLM (OpenAI-compatible)
# - Leave API URL empty to enable built-in mock responses.
# - API key is configured in the UI (stored in localStorage).
VITE_LLM_API_URL=http://localhost:8080/v1

# Optional aliases (supported by codebase)
# VITE_LLM_ENDPOINT=http://localhost:8080/v1
# VITE_LLM_API_BASE=http://localhost:8080/v1

# Force mock mode even if API URL is present (recommended for Vercel demos)
VITE_LLM_FORCE_MOCK=false

